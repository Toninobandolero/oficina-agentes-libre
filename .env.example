# Copia este archivo como .env y rellénalo. Nunca subas .env a git.
# Guía completa de cada servicio (Telegram, correo, LinkedIn, Facebook, Zadarma, ElevenLabs…): CONFIGURACION.md

# --- Inteligencia artificial ---
# Lo normal es pegar las claves en el panel (Configuración → Inteligencia artificial): se guardan cifradas y mandan sobre esto.
# Aquí solo como alternativa. Claude: platform.claude.com → API keys. OpenRouter (opcional, alternativa o respaldo): openrouter.ai → Keys.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# PROVEEDOR_IA=anthropic          # anthropic | openrouter (si no se pone: Claude si hay su clave)
# RESPALDO_OPENROUTER=true        # si se acaba el crédito de Claude, seguir con OpenRouter (si hay su clave)

# --- Obligatorio ---
# Solo si instalas sin Docker: la dirección de la base de datos (con Docker la pone docker-compose.yml)
# DATABASE_URL=postgres://localhost/oficina
# Contraseña de la base de datos (inventa una larga)
DB_PASSWORD=cambia-esto-por-una-larga
# Contraseña para entrar al panel (sin ella, el panel queda abierto: ponla siempre)
PANEL_PASSWORD=
# Dirección pública del panel (la usan LinkedIn, Facebook, el calendario y Lola)
PANEL_URL=https://oficina.tuempresa.com
# La misma dirección, sin https://. La usa la puerta de entrada con HTTPS
DOMINIO=
# Enciende esa puerta de entrada. Bórrala si en este servidor ya tienes tu propio proxy
COMPOSE_PROFILES=https
# Clave para cifrar lo que se pega en el panel (Zadarma, LinkedIn, Facebook…). Inventa una larga y NO la cambies:
# si cambia, hay que volver a pegar esas claves. Si la dejas vacía se deriva de PANEL_PASSWORD (y cambiar la contraseña la rompe).
CLAVE_CIFRADO=

# --- Modelos (uno por agente). Déjalos vacíos para usar los recomendados ---
# MODELO_LUCIA=anthropic/claude-haiku-5.5
# MODELO_MATEO=anthropic/claude-haiku-5.5
# MODELO_CARMEN=anthropic/claude-haiku-5.5
# MODELO_JAVI=anthropic/claude-sonnet-5.5
# MODELO_PAULA=anthropic/claude-sonnet-5.5
# MODELO_ALEX=anthropic/claude-sonnet-5.5
# MODELO_NURIA=anthropic/claude-sonnet-5.5
# MODELO_PILAR=anthropic/claude-sonnet-5.5
# MODELO_RAFA=anthropic/claude-haiku-5.5
# MODELO_SARA=anthropic/claude-sonnet-5.5
# MODELO_LEO=anthropic/claude-sonnet-5.5
# MODELO_MARTA=anthropic/claude-sonnet-5.5
# MODELO_BUSQUEDA=anthropic/claude-haiku-5.5

# --- Gasto ---
# Presupuesto inicial en euros al mes. Desde el panel (clic en «IA: …») se cambia a semanal, se le da un empujón,
# se deja una semana a 0 (vacaciones) o se activa el modo turbo. Al 80 % avisa; al llegar, el equipo se pausa solo.
PRESUPUESTO_EUR=50
# Cambio aproximado dólar → euro (Claude y OpenRouter cobran en dólares)
USD_EUR=0.86

# --- A quién buscamos ---
SECTORES_PRIORITARIOS=
# Vacías: se usan el cliente ideal, los sectores y la zona de Configuración › Mi empresa.
# Qué busca Lucía (separado por |): rota entre ellas. Cuántas empresas al día o a la semana se elige en el panel, en «IA: …».
BUSQUEDAS_AUTO=
EMPRESAS_POR_BUSQUEDA=8
# Provincia que se mira por defecto en el Registro Mercantil (BORME)
BORME_PROVINCIA=

# --- Ritmo de trabajo (el modo turbo del panel quita estos topes mientras haya presupuesto) ---
# Empresas que Mateo puntúa como máximo al día
MAX_ANALISIS_DIA=40
# Agentes trabajando a la vez (en turbo, 2 más)
CONCURRENCIA=2
# Pasos máximos de un agente en una tarea
# MAX_TURNOS=24

# --- Telegram (avisos y aprobaciones en el móvil) ---
# Token de @BotFather y tu id de chat (ver CONFIGURACION.md)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Tu id de usuario de Telegram (si el chat es privado, es el mismo que TELEGRAM_CHAT_ID)
TELEGRAM_USER_ID=

# --- Correo de la oficina (opcional): sin esto, el equipo no envía ni lee correo ---
# CORREO_USUARIO=oficina@tudominio.com
# CORREO_CLAVE=
# CORREO_SMTP=smtp.hostinger.com:465
# CORREO_IMAP=imap.hostinger.com:993
# CORREO_NOMBRE=Tu Empresa

# --- LinkedIn (opcional): el Client ID de tu app. El Client Secret se pega en el panel (Tu mesa → LinkedIn) ---
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# --- Formulario de tu web (opcional): webs desde las que se aceptan formularios en /api/entrada ---
# ENTRADA_ORIGENES=https://tudominio.com,https://www.tudominio.com

# --- Se configuran desde el panel (no van aquí): Facebook, bot de contacto de Telegram, centralita Zadarma,
#     recepcionista de voz (Lola, ElevenLabs) y calendario en el móvil. Ver CONFIGURACION.md ---

# --- Horarios (opcional) ---
# SUENO_DESDE=23:30        # de esta hora…
# SUENO_HASTA=08:00        # …a esta, Telegram calla y a la hora de despertar llega un resumen
# MESA_MAX=12              # con tantas cosas pendientes en tu mesa, Javi, Álex y Nuria esperan
# REUNION_DIA=1            # reunión de equipo (0 = domingo … 6 = sábado)
# REUNION_HORA=10:00
# INTELIGENCIA_DIA=5       # informe semanal de Sara
# INTELIGENCIA_HORA=09:30

# Puerto local del servidor (Caddy apunta aquí). Solo con Docker: sin Docker es PUERTO_INTERNO, por defecto 3000
PUERTO=3200
